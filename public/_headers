# En-têtes pour Netlify et Cloudflare Pages.
# GitHub Pages ne les applique pas : la politique de contenu est aussi
# déclarée dans une balise meta (src/layouts/Base.astro), sans frame-ancestors
# que les balises meta ne prennent pas en charge.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'none'; connect-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; manifest-src 'self'; media-src 'none'; upgrade-insecure-requests
