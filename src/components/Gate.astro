---
interface Props {
  i: number;
}
const { i } = Astro.props;
---

<div class="gate" data-i={i} aria-hidden="true">
  <svg class="gate-far" viewBox="0 0 800 800">
    <g class="ring ring-1"><ellipse cx="400" cy="400" rx="392" ry="358" /></g>
    <g class="ring ring-2"><ellipse cx="400" cy="400" rx="348" ry="322" transform="rotate(11 400 400)" /></g>
  </svg>
  <svg class="gate-mid" viewBox="0 0 800 800">
    <ellipse class="glow" cx="400" cy="400" rx="300" ry="268" />
    <g class="ring ring-2"><ellipse cx="400" cy="400" rx="286" ry="264" transform="rotate(-14 400 400)" /></g>
    <g class="ring ring-3"><ellipse cx="400" cy="400" rx="214" ry="198" /></g>
  </svg>
  <svg class="gate-near" viewBox="0 0 800 800">
    <g class="ring ring-4"><ellipse cx="400" cy="400" rx="150" ry="138" transform="rotate(18 400 400)" /></g>
    <g class="dust">
      <circle cx="196" cy="246" r="1.7" />
      <circle cx="590" cy="286" r="1.2" />
      <circle cx="512" cy="548" r="1.8" />
      <circle cx="278" cy="572" r="1.15" />
      <circle cx="640" cy="430" r="1.3" />
      <circle cx="168" cy="418" r="1.45" />
      <circle cx="430" cy="168" r="1.1" />
    </g>
  </svg>
</div>
