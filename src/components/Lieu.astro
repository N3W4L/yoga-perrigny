---
import { Picture } from 'astro:assets';
import hall from '../assets/salle-2025.jpg';
import { association, itinerary } from '../data/site';
---

<section class="section lieu" id="lieu" aria-labelledby="lieu-title">
  <div class="wrap">
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">Perrigny</p>
        <h2 id="lieu-title">Le lieu</h2>
        <p class="address">
          <span>{association.street}</span>
          <span>{association.postal}</span>
        </p>
        <p class="stack-top">
          Les cours ont lieu à la salle de sports de Perrigny, au-dessus de la salle des fêtes. La salle est équipée d’un ascenseur.
        </p>
        <p>
          <a href={itinerary} target="_blank" rel="noopener noreferrer">
            Itinéraire vers la salle <span class="sr-only">(nouvel onglet)</span>
          </a>
        </p>
        <p class="pending">[Stationnement, entrée, accès détaillé : à compléter]</p>
      </div>
      <figure class="reveal">
        <Picture
          src={hall}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[480, 768, 1024]}
          sizes="(min-width: 62rem) 34rem, 100vw"
          alt="Cours de yoga dans la salle de sports de Perrigny : un groupe en fente, les bras levés, sur un sol vert. Photo du 20 novembre 2025."
          quality={68}
          pictureAttributes={{ class: 'frame' }}
          class="frame"
        />
        <figcaption class="caption">
          Salle de sports, 20 novembre 2025.
          <span class="pending">[Crédit photographique : à compléter]</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
