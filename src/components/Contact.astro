---
import { association } from '../data/site';

const people = [
  { name: 'Anne-Marie Meudre', phone: '07 86 82 05 45', tel: '+33786820545' },
  { name: 'Odile Sappez', phone: '06 23 95 12 37', tel: '+33623951237' },
  { name: 'Françoise Bataillard', phone: '06 26 25 65 88', tel: '+33626256588' },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow">Écrire au club</p>
    <h2 id="contact-title">Contact</h2>
    <p class="lede">Pour toute question, écrivez à l’association. Il n’y a pas de formulaire sur le site.</p>
    <p>
      <a class="contact-mail" href={`mailto:${association.email}`}>{association.email}</a>
    </p>
    <p class="stack-top">
      <a class="btn" href={`mailto:${association.email}`}>Nous écrire</a>
    </p>

    <div class="contact-grid">
      <div>
        <h3>Association</h3>
        <p>
          {association.phonePerson}<br />
          <a href={`tel:${association.phoneTel}`}>{association.phoneDisplay}</a><br />
          <a href={`mailto:${association.phoneEmail}`}>{association.phoneEmail}</a>
        </p>
        <p class="stack-top">
          Yoga adapté : pour toute info, ce numéro, ce courriel, ou chez vous sur rendez-vous.
        </p>
      </div>
      <div>
        <h3>Salle</h3>
        <p>
          {association.street}<br />
          {association.postal}<br />
          {association.place}
        </p>
      </div>
      <div>
        <h3>Professeures</h3>
        <ul class="contacts">
          {
            people.map((person) => (
              <li>
                {person.name} — <a href={`tel:${person.tel}`}>{person.phone}</a>
              </li>
            ))
          }
          <li>
            Sandrine Peyronel —
            <a href={`mailto:${association.email}`}>{association.email}</a>
            <span class="pending">[Téléphone : à compléter]</span>
          </li>
        </ul>
        <p class="stack-top">
          <a href="#tarifs">Adresses pour l’envoi des fiches</a>
        </p>
      </div>
    </div>
  </div>
</section>
