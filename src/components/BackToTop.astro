---
const base = import.meta.env.BASE_URL;
const onHome = Astro.url.pathname === base;
---

<a class="to-top" href={onHome ? '#accueil' : `${base}#accueil`} data-to-top hidden>
  <span class="sr-only">Retour en haut</span>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path d="M8 3.2 13 9.1H9.4V13H6.6V9.1H3L8 3.2Z" fill="currentColor"></path>
  </svg>
</a>
