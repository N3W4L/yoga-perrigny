---
import { flags } from '../config';
import { association, days } from '../data/site';
import Absences from './Absences.astro';

interface Props {
  showAbsences?: boolean;
}

const { showAbsences = false } = Astro.props;
---

<section class="section horaires" id="horaires" aria-labelledby="horaires-title">
  <div class="wrap">
    <p class="eyebrow">Saison 2026-2027</p>
    <h2 id="horaires-title">Horaires</h2>
    <p class="lede">
      {association.place} {association.street}, {association.postal}. La salle du yoga adapté est équipée d’un ascenseur.
    </p>

    <div class="week stack">
      {
        days.map((day) => (
          <article class="day reveal">
            <h3>{day.label}</h3>
            {day.sessions.map((session) => (
              <div class="session">
                <p class="kicker">{session.type}</p>
                <p class="time">{session.time}</p>
                <p>{session.teacher}</p>
              </div>
            ))}
          </article>
        ))
      }
    </div>

    <p class="reprise">Reprise les 15, 16 ou 17 septembre 2026 (selon jour de cours).</p>

    {showAbsences && <Absences />}
    {
      !showAbsences && flags.showActualites && (
        <p class="reprise">
          Les interruptions déjà connues sont dans les <a href="#actualites">actualités</a>.
        </p>
      )
    }
  </div>
</section>
