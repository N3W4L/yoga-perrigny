---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-anne-marie-meudre.png';

const teachers = [
  {
    name: 'Françoise Bataillard',
    initials: 'FB',
    when: ['Lundi, 18 h 45 à 20 h 15 — yoga classique'],
    intro: 'Françoise Bataillard enseigne le yoga à l’association Chemins d’Éveil, à Perrigny.',
    contact: ['130, rue du presbytère, 39570 Revigny', '06 26 25 65 88'],
    tel: '+33626256588',
    phone: '06 26 25 65 88',
    gaps: ['Photo : à compléter', 'Formation : à compléter', 'Approche d’une séance : à compléter'],
  },
  {
    name: 'Sandrine Peyronel',
    initials: 'SP',
    when: [
      'Mardi, 17 h 00 à 18 h 30 et 18 h 45 à 20 h 15 — yoga classique',
      'Mercredi, 17 h 45 à 19 h 15 — yoga classique',
    ],
    intro: 'Sandrine Peyronel enseigne le yoga à l’association Chemins d’Éveil, à Perrigny.',
    mail: 'yogaperrigny@orange.fr',
    gaps: [
      'Photo : à compléter',
      'Téléphone : à compléter',
      'Formation : à compléter',
      'Approche d’une séance : à compléter',
    ],
  },
  {
    name: 'Odile Sappez',
    initials: 'OS',
    when: ['Mardi, 15 h 00 à 16 h 15 — yoga adapté'],
    intro: 'Odile Sappez enseigne le yoga adapté à l’association Chemins d’Éveil, à Perrigny.',
    contact: ['3, rue du petit Bourg, 39570 Montaigu', '06 23 95 12 37'],
    tel: '+33623951237',
    phone: '06 23 95 12 37',
    formation:
      'École Française de Yoga Auvergne Rhône-Alpes, 2011-2015, diplôme 2016 (Boris Tatzky), Yoga de l’énergie. Post-formation Institut International de Yoga / Yogi Babacar Khane, 2017-2020 (yoga égyptien, yoga chinois, hatha yoga).',
    approach:
      'Enseignement « selon la pédagogie de Maître Babacar Khane ». Déroulement indicatif : intériorisation, yoga égyptien, yoga de la tradition chinoise, postures de yoga indien, relaxation et approche de la méditation.',
    gaps: [
      'Photo : à compléter',
      'E-mail personnel : publication à confirmer',
      'Texte de formation issu de la fiche, à relire par Odile',
      'Enseignement hors association mentionné sur la fiche : à confirmer',
    ],
  },
];
---

<section class="section profs" id="professeurs" aria-labelledby="profs-title">
  <div class="wrap">
    <p class="eyebrow">L’équipe</p>
    <h2 id="profs-title">Professeurs</h2>
    <div class="teacher-grid stack">
      {
        [...teachers.slice(0, 2), null, ...teachers.slice(2)].map((teacher) =>
          teacher === null ? (
            <article class="teacher reveal">
              <Picture
                src={portrait}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                width={90}
                height={90}
                alt="Portrait d’Anne-Marie Meudre, professeure de yoga à l’association Chemins d’Éveil."
                class="avatar"
              />
              <div>
                <h3>Anne-Marie Meudre</h3>
                <p class="when">Mercredi, 19 h 30 à 21 h 00 — yoga classique</p>
                <p>Anne-Marie Meudre enseigne le yoga à l’association Chemins d’Éveil, à Perrigny.</p>
                <p>285, rue du puits à sel, 39570 Perrigny</p>
                <p>
                  <a href="tel:+33786820545">07 86 82 05 45</a>
                </p>
                <p>
                  École Française de Yoga Auvergne Rhône-Alpes, 2002-2006, diplôme 2006, Yoga de l’énergie (Lyon 5e). Formateurs cités sur la fiche : Boris Tatzky, Cécile Beaudin, Claire-Line Hédouin, Myllarka Aeply, Patrick Tomatis, Philippe de Fallois. Stages suivis notamment avec Ora Josef Hay et Cécile Beaudin, Babacar Khane, Yvette Clouet, Tiwari, Maurice Daubard, Pierre Gariel.
                </p>
                <p>
                  Déroulement indicatif d’une séance : « intériorisation, enchaînement avec respiration, relaxation, préparation spécifique de posture(s), posture(s) et complémentarité, relaxation ou assise avec respiration et/ou méditation. »
                </p>
                <p class="pending">[E-mail personnel : publication à confirmer]</p>
                <p class="pending">[Texte de formation issu de la fiche, à relire par Anne-Marie.]</p>
                <p class="pending">[Autres activités indiquées sur la fiche : à confirmer avant publication.]</p>
                <p class="pending">[Accord de republication du portrait : à confirmer]</p>
              </div>
            </article>
          ) : (
          <article class="teacher reveal">
            <p class="monogram" aria-hidden="true">
              {teacher.initials}
            </p>
            <div>
              <h3>{teacher.name}</h3>
              {teacher.when.map((line) => (
                <p class="when">{line}</p>
              ))}
              <p>{teacher.intro}</p>
              {teacher.contact?.map((line) =>
                line === teacher.phone ? (
                  <p>
                    <a href={`tel:${teacher.tel}`}>{line}</a>
                  </p>
                ) : (
                  <p>{line}</p>
                ),
              )}
              {teacher.mail && (
                <p>
                  <a href={`mailto:${teacher.mail}`}>{teacher.mail}</a>
                </p>
              )}
              {teacher.formation && <p>{teacher.formation}</p>}
              {teacher.approach && <p>{teacher.approach}</p>}
              {teacher.gaps.map((gap) => (
                <p class="pending">[{gap}]</p>
              ))}
            </div>
          </article>
          )
        )
      }
    </div>
  </div>
</section>
