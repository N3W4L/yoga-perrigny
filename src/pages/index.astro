---
/**
 * Page d'accueil : le trajet en 12 écrans.
 * Tout le texte vient de src/contenu/*.json, modifiable depuis /admin.
 */
import { Picture } from 'astro:assets';
import Logo from '../components/Logo.astro';
import {
  accueil,
  adapte,
  adaptedSlots,
  association,
  club,
  contact,
  inscriptions,
  lieu,
  menu,
  professeures,
  reglages,
  seances,
  showStage,
  slotsOf,
  stage,
  tarifs,
  temoignages,
} from '../contenu';
import Base from '../layouts/Base.astro';
import { inline, siteUrl } from '../lib/md';
import { photo } from '../lib/photos';
import '../styles/souffle.css';

const mailto = `mailto:${association.email}`;
const postal = `${association.code_postal} ${association.ville}`;

/** Ordre des écrans du trajet. Le stage n'apparaît que s'il est affiché (réglages). */
const stations = [
  'accueil',
  'club',
  'seances',
  'adapte',
  'professeurs',
  'tarifs',
  'inscriptions',
  ...(showStage ? ['stage', 'programme'] : []),
  'paroles',
  'lieu',
  'contact',
];
const at = (id: string) => String(stations.indexOf(id));
/** Numéro de chapitre affiché : 01, 02… */
const num = (id: string) => String(stations.indexOf(id)).padStart(2, '0');

/** Actualités de l'accueil : une entrée vers le stage disparaît si le stage est masqué. */
const news = accueil.a_la_une.filter((item) => showStage || item.cible !== 'stage');

const clubPhoto = photo(club.photo)!;
const lieuPhoto = photo(lieu.photo)!;

const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
/* Données structurées pour les moteurs de recherche (bloc de données, non exécuté : compatible avec la CSP). */
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: `${association.nom} — Yoga Perrigny`,
  description: 'Association de yoga à Perrigny (Jura) : cours hebdomadaires, yoga adapté et stages.',
  url: home,
  image: new URL('og.jpg', home).href,
  email: association.email,
  telephone: association.telephone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: association.rue,
    postalCode: association.code_postal,
    addressLocality: association.ville,
    addressCountry: 'FR',
  },
}).replace(/</g, '\\u003c');
---

<Base title={reglages.seo.titre} description={reglages.seo.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <div class="souffle">
    <header class="s-nav" data-header>
      <a class="s-mark" href="#accueil" aria-label="Yoga Perrigny, accueil"><Logo /></a>
      <nav class="s-links" aria-label="Sections">
        {menu.map((item) => (
          <a href={`#${item.id}`} data-nav-link>{item.label}</a>
        ))}
      </nav>
      <a class="s-write" href={mailto}>Écrire</a>
      <details class="s-menu" data-menu>
        <summary>
          <span class="open-label">Menu</span>
          <span class="close-label">Fermer</span>
        </summary>
        <div class="s-panel">
          <nav aria-label="Sections">
            {menu.map((item) => (
              <a href={`#${item.id}`} data-nav-link>{item.label}</a>
            ))}
          </nav>
          <a class="sbtn" href={mailto}>{accueil.bouton_ecrire}</a>
        </div>
      </details>
    </header>

    <main id="contenu">
      <div class="journey" data-stations={String(stations.length)}>
        <div class="snap-rail" aria-hidden="true">
          {stations.map((_, index) => (
            <div class="snap-stop" data-snap={index}></div>
          ))}
        </div>
        <div class="tunnel">
          <canvas class="rings" aria-hidden="true"></canvas>
          <div class="camera">
          <div class="world">
      <section class="plane s-hero" data-station="0" id="accueil" aria-labelledby="souffle-title">
        <div class="orb" aria-hidden="true">
          <svg viewBox="0 0 800 800">
            <g class="ring ring-1"><ellipse cx="400" cy="400" rx="360" ry="328" /></g>
            <g class="ring ring-2"><ellipse cx="400" cy="400" rx="286" ry="308" transform="rotate(16 400 400)" /></g>
            <g class="ring ring-3"><ellipse cx="400" cy="400" rx="198" ry="180" /></g>
            <g class="ring ring-4"><ellipse cx="400" cy="400" rx="108" ry="122" transform="rotate(-12 400 400)" /></g>
            <circle class="core" cx="400" cy="400" r="3.5" />
          </svg>
        </div>
        <div class="s-hero-copy">
          <p class="s-kicker">{accueil.surtitre}</p>
          <h1 id="souffle-title"><Fragment set:html={inline(accueil.titre)} /></h1>
          <p class="lede"><Fragment set:html={inline(accueil.texte)} /></p>
          <div class="s-actions">
            <a class="sbtn" href="#seances">{accueil.bouton_seances}</a>
            <a class="sbtn-ghost" href={mailto}>{accueil.bouton_ecrire}</a>
          </div>
          {
            reglages.afficher.actualites && news.length > 0 && (
              <nav class="s-news" aria-label="Actualités">
                <span class="s-news-label">{accueil.a_la_une_titre}</span>
                <ul>
                  {news.map((item) => (
                    <li>
                      <a href={`#${item.cible}`}>{item.texte}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
        <p class="s-hero-foot">
          <span>{association.rue} · {postal}</span>
          <a class="s-scroll" href="#club">Défiler <i></i></a>
        </p>
      </section>

      <section class="plane sheet sheet-rise" data-station={at('club')} id="club" aria-labelledby="club-title">
        <div class="s-wrap club-grid">
          <div>
            <p class="chap">{num('club')} — {club.chapitre}</p>
            <h2 id="club-title"><Fragment set:html={inline(club.titre)} /></h2>
            <div class="prose">
              {club.paragraphes.map((paragraphe) => <p set:html={inline(paragraphe)} />)}
              <p>
                <a href={siteUrl(club.document.fichier)}>{club.document.texte} <span class="sr-only">(PDF)</span></a>
              </p>
            </div>
          </div>
          <figure class="frame-photo">
            <Picture
              src={clubPhoto}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[560, 840, 1100]}
              sizes="(min-width: 62rem) 34rem, 100vw"
              alt={club.photo_description}
              quality={74}
            />
            {club.legende && <figcaption>{club.legende}</figcaption>}
          </figure>
        </div>
      </section>

      <section class="plane sheet" data-station={at('seances')} id="seances" aria-labelledby="seances-title">
        <div class="s-wrap">
          <div class="seance-top">
            <div>
              <p class="chap">{num('seances')} — {seances.chapitre}</p>
              <h2 id="seances-title"><Fragment set:html={inline(seances.titre)} /></h2>
            </div>
            <div class="seance-intro">
              <p class="pull"><Fragment set:html={inline(seances.accroche)} /></p>
              <p set:html={inline(seances.texte)} />
            </div>
          </div>
          <ol class="week">
            {
              seances.jours.map((jour) => (
                <li class="day-group">
                  <h3>{jour.jour}</h3>
                  <ul>
                    {jour.seances.map((seance) => (
                      <li class:list={[seance.type === 'Yoga adapté' && 'adapted']}>
                        <span class="hours">{seance.horaire}</span>
                        <span class="who">
                          {seance.professeure}
                          {seance.type === 'Yoga adapté' && <span class="tag">· Yoga adapté</span>}
                        </span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>

          <div class="breaks">
            <h3 class="chap">{seances.interruptions.titre}</h3>
            <div class="breaks-grid">
              {
                seances.interruptions.periodes.map((periode) => (
                  <div>
                    <h4>{periode.titre}</h4>
                    <ul>
                      {periode.lignes.map((ligne) => (
                        <li set:html={inline(ligne)} />
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
            <p class="breaks-link">
              <a href={siteUrl(seances.interruptions.document.fichier)}>
                {seances.interruptions.document.texte} <span class="sr-only">(PDF)</span>
              </a>
            </p>
          </div>
        </div>
      </section>

      <section class="plane sheet" data-station={at('adapte')} id="adapte" aria-labelledby="adapte-title">
        <div class="s-wrap split">
          <div>
            <p class="chap">{num('adapte')} — {adapte.chapitre}</p>
            <h2 id="adapte-title"><Fragment set:html={inline(adapte.titre)} /></h2>
            <p class="pull"><Fragment set:html={inline(adapte.accroche)} /></p>
          </div>
          <div class="prose">
            {adapte.paragraphes.map((paragraphe) => <p set:html={inline(paragraphe)} />)}
            <ul class="facts">
              {
                adaptedSlots.map((slot) => (
                  <li>
                    <span class="label">{adapte.intitule_seance}</span>
                    <span>{slot.label}, avec {slot.teacher}</span>
                  </li>
                ))
              }
              {
                adapte.infos.map((info) => (
                  <li>
                    <span class="label">{info.intitule}</span>
                    <span set:html={inline(info.texte)} />
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <section class="plane sheet" data-station={at('professeurs')} id="professeurs" aria-labelledby="profs-title">
        <div class="s-wrap">
          <p class="chap">{num('professeurs')} — {professeures.chapitre}</p>
          <h2 id="profs-title"><Fragment set:html={inline(professeures.titre)} /></h2>
          <ul class="people">
            {
              professeures.liste.map((prof) => {
                const portrait = photo(prof.photo);
                return (
                  <li class="person">
                    {portrait ? (
                      <Picture
                        src={portrait}
                        formats={['avif', 'webp']}
                        fallbackFormat="jpeg"
                        widths={[104, 208]}
                        sizes="3.25rem"
                        alt={`Portrait de ${prof.nom}, professeure de yoga à l’association ${association.nom}.`}
                      />
                    ) : (
                      <span class="mono" aria-hidden="true">
                        {prof.initiales}
                      </span>
                    )}
                    <div>
                      <h3>{prof.nom}</h3>
                      <p class="meta">{prof.type}</p>
                      <ul class="slots">
                        {slotsOf(prof.nom).map((slot) => (
                          <li>{slot}</li>
                        ))}
                      </ul>
                    </div>
                    <div class="bio">
                      {prof.presentation.map((paragraphe) => (
                        <p set:html={inline(paragraphe)} />
                      ))}
                      {prof.fiche && (
                        <p>
                          <a href={siteUrl(prof.fiche)}>
                            Fiche de présentation <span class="sr-only">de {prof.nom} (PDF)</span>
                          </a>
                        </p>
                      )}
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <section class="plane sheet" data-station={at('tarifs')} id="tarifs" aria-labelledby="tarifs-title">
        <div class="s-wrap">
          <p class="chap">{num('tarifs')} — {tarifs.chapitre}</p>
          <h2 id="tarifs-title"><Fragment set:html={inline(tarifs.titre)} /></h2>
          <p set:html={inline(tarifs.texte)} />
          <ul class:list={['prices', tarifs.prix.length === 3 && 'cols-3']}>
            {
              tarifs.prix.map((prix) => (
                <li>
                  <span class="label">{prix.intitule}</span>
                  <strong>{prix.montant}</strong>
                  {prix.mentions.map((mention) => (
                    <span class="fine" set:html={inline(mention)} />
                  ))}
                </li>
              ))
            }
          </ul>

          <h3 class="chap chap-space">{tarifs.premiere_fois_titre}</h3>
          <ol class="points">
            {
              tarifs.premiere_fois.map((point, index) => (
                <li>
                  <b>{String(index + 1).padStart(2, '0')}</b>
                  <span set:html={inline(point)} />
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section class="plane sheet" data-station={at('inscriptions')} id="inscriptions" aria-labelledby="inscriptions-title">
        <div class="s-wrap">
          <div class="split">
            <div>
              <p class="chap">{num('inscriptions')} — {inscriptions.chapitre}</p>
              <h2 id="inscriptions-title"><Fragment set:html={inline(inscriptions.titre)} /></h2>
              <p class="cta-row">
                <a class="sbtn" href={siteUrl(inscriptions.document.fichier)}>{inscriptions.document.texte}</a>
              </p>
            </div>
            <div class="prose">
              {inscriptions.paragraphes.map((paragraphe) => <p set:html={inline(paragraphe)} />)}
            </div>
          </div>
          <h3 class="chap chap-space" id="envoi">{inscriptions.envoi_titre}</h3>
          <ul class="envoi">
            {
              inscriptions.contacts.map((personne) => (
                <li>
                  <strong>{personne.nom}</strong>
                  {personne.adresse.map((ligne) => (
                    <span>{ligne}</span>
                  ))}
                  {personne.telephone_affiche && (
                    <a href={`tel:${personne.telephone || personne.telephone_affiche.replace(/\s/g, '')}`}>
                      {personne.telephone_affiche}
                    </a>
                  )}
                  {personne.email && <a href={`mailto:${personne.email}`}>{personne.email}</a>}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {
        showStage && (
          <>
            <section class="plane night" data-station={at('stage')} id="stage" aria-labelledby="stage-title">
              <div class="night-orb" aria-hidden="true">
                <svg viewBox="0 0 800 800">
                  <g class="ring ring-2"><ellipse cx="400" cy="400" rx="300" ry="270" /></g>
                  <g class="ring ring-4"><ellipse cx="400" cy="400" rx="180" ry="200" /></g>
                </svg>
              </div>
              <div class="s-wrap">
                <div class="stage-top">
                  <div>
                    <p class="chap">{num('stage')} — {stage.chapitre}</p>
                    <h2 id="stage-title"><Fragment set:html={inline(stage.titre)} /></h2>
                  </div>
                  <div>
                    <p class="pull"><Fragment set:html={inline(stage.accroche)} /></p>
                    {stage.paragraphes.map((paragraphe) => (
                      <p set:html={inline(paragraphe)} />
                    ))}
                  </div>
                </div>
                <div class="stage-facts">
                  {stage.rendez_vous.map((rdv) => (
                    <article>
                      <h3>{rdv.titre}</h3>
                      {rdv.prix && <p class="sum">{rdv.prix}</p>}
                      {rdv.paragraphes.map((paragraphe) => (
                        <p set:html={inline(paragraphe)} />
                      ))}
                    </article>
                  ))}
                </div>
                <p class="cta-row">
                  <a class="sbtn" href={siteUrl(stage.document.fichier)}>{stage.document.texte}</a>
                </p>
              </div>
            </section>

            <section class="plane night" data-station={at('programme')} data-nav="stage" id="programme" aria-labelledby="programme-title">
              <div class="s-wrap">
                <p class="chap">{num('programme')} — {stage.programme.chapitre}</p>
                <h2 id="programme-title"><Fragment set:html={inline(stage.programme.titre)} /></h2>
                <div class="program-grid">
                  {stage.programme.colonnes.map((colonne) => (
                    <div>
                      <h3>{colonne.titre}</h3>
                      {colonne.paragraphes.map((paragraphe) => (
                        <p set:html={inline(paragraphe)} />
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          </>
        )
      }

      <section class="plane sheet" data-station={at('paroles')} id="paroles" aria-labelledby="paroles-title">
        <div class="s-wrap">
          <p class="chap">{num('paroles')} — {temoignages.chapitre}</p>
          <h2 id="paroles-title"><Fragment set:html={inline(temoignages.titre)} /></h2>
          <figure class="feature-quote">
            <p>« {temoignages.citation.texte} »</p>
            <figcaption>{temoignages.citation.auteur}</figcaption>
          </figure>
          <div class="voices">
            {
              temoignages.voix.map((voix) => (
                <figure class="voice">
                  <blockquote>
                    {voix.phrases.map((phrase) => (
                      <p>« {phrase} »</p>
                    ))}
                  </blockquote>
                  <figcaption>{voix.auteur}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="plane sheet" data-station={at('lieu')} id="lieu" aria-labelledby="lieu-title">
        <div class="s-wrap lieu-grid">
          <div>
            <p class="chap">{num('lieu')} — {lieu.chapitre}</p>
            <h2 id="lieu-title"><Fragment set:html={inline(lieu.titre)} /></h2>
            <p class="address">
              <span>{association.rue}</span>
              <span>{postal}</span>
            </p>
            <p>{association.salle}.</p>
            <p>{lieu.texte_acces} · <a href={reglages.itineraire}>{lieu.texte_itineraire}</a></p>
            {
              lieu.ressources.length > 0 && (
                <ul class="library">
                  {lieu.ressources.map((ressource) => (
                    <li set:html={inline(ressource)} />
                  ))}
                </ul>
              )
            }
          </div>
          <figure class="frame-photo frame-photo-place">
            <Picture
              src={lieuPhoto}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[400, 640, 900]}
              sizes="(min-width: 62rem) 22rem, 100vw"
              alt={lieu.photo_description}
              quality={70}
            />
            {lieu.legende && <figcaption>{lieu.legende}</figcaption>}
          </figure>
        </div>
      </section>

      <section class="plane sheet" data-station={at('contact')} id="contact" aria-labelledby="contact-title">
        <div class="s-wrap">
          <p class="chap">{contact.chapitre}</p>
          <h2 id="contact-title"><Fragment set:html={inline(contact.titre)} /></h2>
          <p set:html={inline(contact.texte)} />
          <p><a class="mail" href={mailto}>{association.email}</a></p>
          <p>
            {association.contact_nom} · <a href={`tel:${association.telephone}`}>{association.telephone_affiche}</a> · <a href={`mailto:${association.contact_email}`}>{association.contact_email}</a>
          </p>
          <p><a href="#inscriptions">{contact.lien_envoi}</a></p>
        </div>
        <footer class="s-foot">
          <div class="s-wrap">
            <div class="s-foot-row">
              <a class="s-mark" href="#accueil" aria-label="Yoga Perrigny"><Logo /></a>
              <nav aria-label="Pied de page">
                <ul>
                  <li><a href={`${import.meta.env.BASE_URL}mentions-legales/`}>Mentions légales</a></li>
                  <li><a href={`${import.meta.env.BASE_URL}confidentialite/`}>Politique de confidentialité</a></li>
                  <li><a href={mailto}>Contact</a></li>
                </ul>
              </nav>
            </div>
            <p>{contact.pied_de_page}</p>
          </div>
        </footer>
      </section>
          </div>
          </div>
        </div>
      </div>
    </main>

    <p class="progress-count" aria-hidden="true" data-progress-count></p>
    <svg class="progress" viewBox="0 0 40 40" aria-hidden="true">
      <circle class="track" cx="20" cy="20" r="16" fill="none" />
      <circle data-progress cx="20" cy="20" r="16" fill="none" transform="rotate(-90 20 20)" />
    </svg>
  </div>
  <script>
    import '../scripts/souffle.ts';
  </script>
</Base>
