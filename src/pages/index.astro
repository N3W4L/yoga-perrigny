---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait-anne-marie-meudre.png';
import hall from '../assets/salle-2025.jpg';
import exterior from '../assets/salle-exterieur.jpg';
import Logo from '../components/Logo.astro';
import { flags } from '../config';
import { association, days, itinerary, pdfs } from '../data/site';
import Base from '../layouts/Base.astro';
import '../styles/souffle.css';

const mailto = `mailto:${association.email}`;

/** Ordre des écrans du trajet. Le stage n'apparaît que si showStage. */
const stations = [
  'accueil',
  'club',
  'seances',
  'adapte',
  'paroles',
  'tarifs',
  'inscriptions',
  ...(flags.showStage ? ['stage', 'programme'] : []),
  'professeurs',
  'lieu',
  'contact',
];
const at = (id: string) => String(stations.indexOf(id));
/** Numéro de chapitre affiché : 01, 02… */
const num = (id: string) => String(stations.indexOf(id)).padStart(2, '0');

/** Séances de yoga adapté, tirées de la grille. */
const adaptedSlots = days.flatMap((day) =>
  day.sessions
    .filter((session) => session.type === 'Yoga adapté')
    .map((session) => ({ label: `${day.label} · ${session.time}`, teacher: session.teacher })),
);

const teachers = [
  {
    name: 'Françoise Bataillard',
    initials: 'FB',
    type: 'Yoga classique',
    bio: ['Enseigne le yoga à l’association Chemins d’Éveil, à Perrigny.'],
  },
  {
    name: 'Sandrine Peyronel',
    initials: 'SP',
    type: 'Yoga classique',
    bio: ['Enseigne le yoga à l’association Chemins d’Éveil, à Perrigny.'],
  },
  {
    name: 'Anne-Marie Meudre',
    initials: 'AM',
    type: 'Yoga classique',
    portrait: true,
    bio: [
      'Formée à l’École Française de Yoga Auvergne Rhône-Alpes (2002-2006), diplômée en 2006 : Yoga de l’énergie. Stages notamment avec Ora Josef Hay, Cécile Beaudin, Babacar Khane, Yvette Clouet, Maurice Daubard et Pierre Gariel.',
      'Une séance : intériorisation, enchaînement avec respiration, relaxation, préparation des postures, postures, puis relaxation ou assise avec respiration et méditation.',
    ],
  },
  {
    name: 'Odile Sappez',
    initials: 'OS',
    type: 'Yoga adapté',
    bio: [
      'Formée à l’École Française de Yoga Auvergne Rhône-Alpes (2011-2015), diplômée en 2016 : Yoga de l’énergie. Post-formation auprès de Yogi Babacar Khane (2017-2020) : yoga égyptien, yoga chinois, hatha yoga.',
      'Une séance, selon la pédagogie de Maître Babacar Khane : intériorisation, yoga égyptien, yoga de la tradition chinoise, postures de yoga indien, relaxation et approche de la méditation.',
    ],
  },
];

/** Adresses d'envoi des fiches. */
const senders = [
  { name: 'Anne-Marie Meudre', lines: ['285, rue du puits à sel', '39570 Perrigny'], tel: ['+33786820545', '07 86 82 05 45'] },
  { name: 'Sandrine Peyronel', lines: [], mail: association.email },
  { name: 'Odile Sappez', lines: ['3, rue du petit Bourg', '39570 Montaigu'], tel: ['+33623951237', '06 23 95 12 37'] },
  { name: 'Françoise Bataillard', lines: ['130, rue du presbytère', '39570 Revigny'], tel: ['+33626256588', '06 26 25 65 88'] },
];

/** Créneaux de chaque professeure, tirés de la grille des séances : une seule source à tenir à jour. */
const slotsOf = (teacher: string) =>
  days.flatMap((day) =>
    day.sessions.filter((session) => session.teacher === teacher).map((session) => `${day.label} · ${session.time}`),
  );
const home = new URL(import.meta.env.BASE_URL, Astro.site).href;
/* Données structurées pour les moteurs de recherche (bloc de données, non exécuté : compatible avec la CSP). */
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: `${association.name} — Yoga Perrigny`,
  description: 'Association de yoga à Perrigny (Jura) : cours hebdomadaires, yoga adapté et stages.',
  url: home,
  image: new URL('og.jpg', home).href,
  email: association.email,
  telephone: association.phoneTel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: association.street,
    postalCode: '39570',
    addressLocality: 'Perrigny',
    addressCountry: 'FR',
  },
}).replace(/</g, '\\u003c');
const voices = [
  {
    name: 'Claudette',
    lines: [
      'C’est incroyable ce qu’elle nous fait faire.',
      'Pendant les exercices, on sent que ça travaille dans le corps. Après la séance, je suis bien détendue.',
      'En cours de yoga adapté on pratique sur chaise ou debout avec un appui.',
      'La prof est formidable. Elle connaît nos limites et prend en compte les difficultés de chacun-e.',
      'En plus on est content de se retrouver. On forme un bon groupe et c’est très important.',
    ],
  },
  {
    name: 'Geneviève',
    lines: ['Je suis mieux en partant qu’en arrivant.', 'Notre prof est attentive à chacun-e.'],
  },
  {
    name: 'Claude, élève depuis un an',
    lines: [
      'J’apprécie cette discipline qui m’apporte respiration et relaxation intérieures.',
      'Notre animatrice véritable maître yogi est très investie, passionnée.',
    ],
  },
  {
    name: 'Jacqueline, 18 ans de pratique à Chemins d’Éveil',
    lines: [
      'Un espace-temps, rien que pour soi où la bienveillance est d’actualité et les bénéfices psychiques et physiques sont nombreux.',
      'Des séances toujours différentes au fil des ans et adaptées avec des professeures de qualité.',
    ],
  },
  {
    name: 'Sylvie',
    lines: ['Nouvelle expérience pour moi, avec un groupe de personnes sympas.'],
  },
];
---

<Base
  title="Cours de yoga à Perrigny — Chemins d’Éveil"
  description="Cours de yoga à Perrigny. Association Chemins d’Éveil, salle de sports, 76 rue du moulin, 39570 Perrigny."
>
  <script slot="head" type="application/ld+json" is:inline set:html={structuredData} />
  <div class="souffle">
    <header class="s-nav" data-header>
      <a class="s-mark" href="#accueil" aria-label="Yoga Perrigny, accueil"><Logo /></a>
      <nav class="s-links" aria-label="Sections">
        <a href="#club" data-nav-link>Le club</a>
        <a href="#seances" data-nav-link>Séances</a>
        <a href="#tarifs" data-nav-link>Tarifs</a>
        {flags.showStage && <a href="#stage" data-nav-link>Stage</a>}
        <a href="#professeurs" data-nav-link>Professeures</a>
        <a href="#lieu" data-nav-link>Lieu</a>
      </nav>
      <a class="s-write" href={mailto}>Écrire</a>
      <details class="s-menu" data-menu>
        <summary>
          <span class="open-label">Menu</span>
          <span class="close-label">Fermer</span>
        </summary>
        <div class="s-panel">
          <nav aria-label="Sections">
            <a href="#club" data-nav-link>Le club</a>
            <a href="#seances" data-nav-link>Séances</a>
            <a href="#tarifs" data-nav-link>Tarifs</a>
            {flags.showStage && <a href="#stage" data-nav-link>Stage</a>}
            <a href="#professeurs" data-nav-link>Professeures</a>
            <a href="#lieu" data-nav-link>Lieu</a>
          </nav>
          <a class="sbtn" href={mailto}>Nous écrire</a>
        </div>
      </details>
    </header>

    <main id="contenu">
      <div class="journey" data-stations={String(stations.length)}>
        <div class="snap-rail" aria-hidden="true">
          {stations.map((_, index) => (
            <div class="snap-stop" data-snap={index}></div>
          ))}
        </div>
        <div class="tunnel">
          <canvas class="rings" aria-hidden="true"></canvas>
          <div class="camera">
          <div class="world">
      <section class="plane s-hero" data-station="0" id="accueil" aria-labelledby="souffle-title">
        <div class="orb" aria-hidden="true">
          <svg viewBox="0 0 800 800">
            <g class="ring ring-1"><ellipse cx="400" cy="400" rx="360" ry="328" /></g>
            <g class="ring ring-2"><ellipse cx="400" cy="400" rx="286" ry="308" transform="rotate(16 400 400)" /></g>
            <g class="ring ring-3"><ellipse cx="400" cy="400" rx="198" ry="180" /></g>
            <g class="ring ring-4"><ellipse cx="400" cy="400" rx="108" ry="122" transform="rotate(-12 400 400)" /></g>
            <circle class="core" cx="400" cy="400" r="3.5" />
          </svg>
        </div>
        <div class="s-hero-copy">
          <p class="s-kicker">Perrigny · Jura</p>
          <h1 id="souffle-title">Chemins <em>d’Éveil</em></h1>
          <p class="lede">
            Yoga à Perrigny, dans le Jura. L’association propose des cours et des stages, pour pratiquer à tout âge, sans recherche de performance.
          </p>
          <div class="s-actions">
            <a class="sbtn" href="#seances">Voir les séances</a>
            <a class="sbtn-ghost" href={mailto}>Nous écrire</a>
          </div>
        </div>
        <p class="s-hero-foot">
          <span>{association.street} · {association.postal}</span>
          <a class="s-scroll" href="#club">Défiler <i></i></a>
        </p>
      </section>

      <section class="plane sheet sheet-rise" data-station={at('club')} id="club" aria-labelledby="club-title">
        <div class="s-wrap club-grid">
          <div>
            <p class="chap">{num('club')} — L’association</p>
            <h2 id="club-title">Le club</h2>
            <div class="prose">
              <p>
                À l’origine, le yoga se pratiquait pour atteindre la clarté du mental, le calme et l’apaisement des pensées. Aujourd’hui, l’enseignement reste ancré dans ses éléments originels, tout en s’ouvrant à la culture occidentale pour être accessible au plus grand nombre.
              </p>
              <p>
                Les cours réunissent des jeunes, des moins jeunes et des personnes très avancées en âge (plus de 90 ans), aux capacités physiques variées : des débutants comme des pratiquants depuis 10, 15, voire 30 ans, en toute simplicité. Les personnes en difficulté bénéficient de séances de yoga adapté.
              </p>
              <p>Une activité encouragée par notre maire, Christiane Maugain. Merci à elle.</p>
              <p>
                <a href={pdfs.article}>Article de présentation 2025 <span class="sr-only">(PDF)</span></a>
              </p>
            </div>
          </div>
          <figure class="frame-photo">
            <Picture
              src={hall}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[480, 768, 1024]}
              sizes="(min-width: 62rem) 34rem, 100vw"
              alt="Cours de yoga dans la salle de sports de Perrigny : un groupe en fente, les bras levés, sur un sol vert. Photo du 20 novembre 2025."
              quality={70}
            />
            <figcaption>Salle de sports, 20 novembre 2025.</figcaption>
          </figure>
        </div>
      </section>

      <section class="plane sheet" data-station={at('seances')} id="seances" aria-labelledby="seances-title">
        <div class="s-wrap">
          <div class="seance-top">
            <div>
              <p class="chap">{num('seances')} — La semaine</p>
              <h2 id="seances-title">Les <em>séances</em></h2>
            </div>
            <div class="seance-intro">
              <p class="pull">6 séances de yoga par semaine.</p>
              <p>Reprise les 15, 16 ou 17 septembre 2026, selon le jour de cours.</p>
            </div>
          </div>
          <ol class="week">
            {
              days.map((day) => (
                <li class="day-group">
                  <h3>{day.label}</h3>
                  <ul>
                    {day.sessions.map((session) => (
                      <li class:list={[session.type === 'Yoga adapté' && 'adapted']}>
                        <span class="hours">{session.time}</span>
                        <span class="who">
                          {session.teacher} · {session.type}
                        </span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>

          <div class="breaks">
            <h3 class="chap">Pas de séance, octobre 2026 – janvier 2027</h3>
            <div class="breaks-grid">
              <div>
                <h4>Vacances d’automne</h4>
                <ul>
                  <li>Sandrine : mardi 20 et mercredi 21 octobre</li>
                  <li>Anne-Marie : mercredis 21 et 28 octobre</li>
                  <li>Françoise : à préciser</li>
                </ul>
              </div>
              <div>
                <h4>11 novembre</h4>
                <ul>
                  <li>Mercredi 11 novembre, férié : pas de séance avec Anne-Marie ni Sandrine</li>
                </ul>
              </div>
              <div>
                <h4>Vacances de Noël</h4>
                <ul>
                  <li>Sandrine : mardi 29 et mercredi 30 décembre</li>
                  <li>Anne-Marie : pendant toutes les vacances scolaires</li>
                  <li>Françoise : à préciser</li>
                </ul>
              </div>
            </div>
            <p class="breaks-link"><a href={pdfs.absences}>Calendrier des animatrices <span class="sr-only">(PDF)</span></a></p>
          </div>
        </div>
      </section>

      <section class="plane sheet" data-station={at('adapte')} id="adapte" aria-labelledby="adapte-title">
        <div class="s-wrap split">
          <div>
            <p class="chap">{num('adapte')} — Pour chacun</p>
            <h2 id="adapte-title">Yoga <em>adapté</em></h2>
            <p class="pull">Des postures en douceur, accessibles à tous.</p>
          </div>
          <div class="prose">
            <p>
              Chemins d’Éveil propose du yoga adapté aux personnes qui ont des difficultés de mouvement (membres, dos…) du fait de l’âge, d’un accident ou d’une maladie.
            </p>
            <p>
              Les séances ont lieu à la salle de sports de Perrigny, l’après-midi, en petit groupe. La salle est équipée d’un ascenseur.
            </p>
            <ul class="facts">
              {
                adaptedSlots.map((slot) => (
                  <li>
                    <span class="label">Séance</span>
                    <span>{slot.label}, avec {slot.teacher}</span>
                  </li>
                ))
              }
              <li>
                <span class="label">Tarif</span>
                <span>185 € l’année, adhésion comprise</span>
              </li>
              <li>
                <span class="label">Renseignements</span>
                <span>
                  {association.phonePerson} · <a href={`tel:${association.phoneTel}`}>{association.phoneDisplay}</a> ·
                  <a href={`mailto:${association.phoneEmail}`}>{association.phoneEmail}</a>. Rencontre possible chez vous, sur rendez-vous.
                </span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="plane sheet" data-station={at('paroles')} id="paroles" aria-labelledby="paroles-title">
        <div class="s-wrap">
          <p class="chap">{num('paroles')} — Témoignages</p>
          <h2 id="paroles-title">Les élèves ont <em>la parole</em></h2>
          <figure class="feature-quote">
            <p>
              « Le yoga, c’est comme le goût des fraises, on ne peut pas l’expliquer. Et en plus, à Perrigny, c’est avec de la chantilly ! »
            </p>
            <figcaption>Marie-Annick</figcaption>
          </figure>
          <div class="voices">
            {
              voices.map((voice) => (
                <figure class="voice">
                  <blockquote>
                    {voice.lines.map((line) => (
                      <p>« {line} »</p>
                    ))}
                  </blockquote>
                  <figcaption>{voice.name}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <section class="plane sheet" data-station={at('tarifs')} id="tarifs" aria-labelledby="tarifs-title">
        <div class="s-wrap">
          <p class="chap">{num('tarifs')} — 2026-2027</p>
          <h2 id="tarifs-title">Tarifs</h2>
          <p>Les professeures s’engagent à assurer 30 séances dans l’année.</p>
          <ul class:list={['prices', !flags.showTarifReduit && 'cols-3']}>
            <li>
              <span class="label">Adhésion</span>
              <strong>30 €</strong>
              <span class="fine">Chèque à l’ordre de l’association Chemins d’Éveil.</span>
            </li>
            <li>
              <span class="label">Yoga classique</span>
              <strong>175 €</strong>
              <span class="fine">Chèque à l’ordre de la professeure, en plus de l’adhésion.</span>
            </li>
            {
              flags.showTarifReduit && (
                <li>
                  <span class="label">Tarif réduit</span>
                  <strong>85 €</strong>
                  <span class="fine">Pour les personnes à faibles revenus.</span>
                </li>
              )
            }
            <li>
              <span class="label">Yoga adapté</span>
              <strong>185 €</strong>
              <span class="fine">Adhésion comprise. Chèque à l’ordre de Chemins d’Éveil. Tarif réduit : voir avec le président.</span>
            </li>
          </ul>

          <h3 class="chap chap-space">Venir la première fois</h3>
          <ol class="points">
            <li>
              <b>01</b>
              <span>Une séance d’essai est possible avant l’inscription : prévenez avant, au cas où le cours serait complet.</span>
            </li>
            <li>
              <b>02</b>
              <span>Tapis et support pour l’assise sont à disposition dans la salle.</span>
            </li>
            <li>
              <b>03</b>
              <span>Apportez une serviette pour le tapis et une couverture.</span>
            </li>
            <li>
              <b>04</b>
              <span>Une tenue souple, dans laquelle vous êtes à l’aise.</span>
            </li>
          </ol>
        </div>
      </section>

      <section class="plane sheet" data-station={at('inscriptions')} id="inscriptions" aria-labelledby="inscriptions-title">
        <div class="s-wrap">
          <div class="split">
            <div>
              <p class="chap">{num('inscriptions')} — S’inscrire</p>
              <h2 id="inscriptions-title">Inscriptions</h2>
              <p class="cta-row">
                <a class="sbtn" href={pdfs.inscription}>Télécharger le formulaire</a>
              </p>
            </div>
            <div class="prose">
              <p>
                Adressez la fiche remplie et le règlement à votre enseignante, et envoyez un courriel à
                <a href={mailto}>{association.email}</a>. L’inscription est effective à réception des trois. Les inscriptions sont enregistrées dans l’ordre d’arrivée ; le nombre d’élèves est limité par séance.
              </p>
              {
                flags.showReinscriptions && (
                  <p>
                    <strong>Réinscriptions</strong> : avant le 1er septembre, par courrier ou lors d’une séance, avec la fiche et le règlement par chèque.
                  </p>
                )
              }
            </div>
          </div>
          <h3 class="chap chap-space" id="envoi">Envoi des fiches et renseignements</h3>
          <ul class="envoi">
            {
              senders.map((sender) => (
                <li>
                  <strong>{sender.name}</strong>
                  {sender.lines.map((line) => (
                    <span>{line}</span>
                  ))}
                  {sender.tel && <a href={`tel:${sender.tel[0]}`}>{sender.tel[1]}</a>}
                  {sender.mail && <a href={`mailto:${sender.mail}`}>{sender.mail}</a>}
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      {
        flags.showStage && (
          <>
            <section class="plane night" data-station={at('stage')} id="stage" aria-labelledby="stage-title">
              <div class="night-orb" aria-hidden="true">
                <svg viewBox="0 0 800 800">
                  <g class="ring ring-2"><ellipse cx="400" cy="400" rx="300" ry="270" /></g>
                  <g class="ring ring-4"><ellipse cx="400" cy="400" rx="180" ry="200" /></g>
                </svg>
              </div>
              <div class="s-wrap">
                <div class="stage-top">
                  <div>
                    <p class="chap">{num('stage')} — 4 au 6 décembre 2026</p>
                    <h2 id="stage-title"><em>Passages</em></h2>
                  </div>
                  <div>
                    <p class="pull">Au seuil de l’hiver, un voyage intérieur.</p>
                    <p>
                      Une invitation à ralentir, à écouter ce qui bat au cœur de soi : postures lentes, souffle, yoga nidra, méditation. 22 participants ; réservations auprès des professeures.
                    </p>
                  </div>
                </div>
                <div class="stage-facts">
                  <article>
                    <h3>Soirée mantras · vendredi 4</h3>
                    <p class="sum">25 €</p>
                    <p>18 h 30 – 21 h 30. Chants du monde et mantras, ouverte à tous. Chèque à l’ordre de « S. Schatz-Botti et F. Botti ».</p>
                  </article>
                  <article>
                    <h3>Stage · samedi 5 et dimanche 6</h3>
                    <p class="sum">80 €</p>
                    <p>Samedi 9 h – 17 h, dimanche 9 h – 12 h. 60 € le samedi seul. Chèque à l’ordre de « Association Chemins d’Éveil ».</p>
                  </article>
                  <article>
                    <h3>Où et quand</h3>
                    <p><a href="#lieu">Salle de sports de Perrigny</a></p>
                    <p>Inscription avant le mercredi 25 novembre 2026.</p>
                  </article>
                </div>
                <p class="cta-row">
                  <a class="sbtn" href={pdfs.stage}>Télécharger la plaquette</a>
                </p>
              </div>
            </section>

            <section class="plane night" data-station={at('programme')} id="programme" aria-labelledby="programme-title">
              <div class="s-wrap">
                <p class="chap">{num('programme')} — Le stage en pratique</p>
                <h2 id="programme-title">Programme et <em>intervenants</em></h2>
                <div class="program-grid">
                  <div>
                    <h3>Déroulement</h3>
                    <p><strong>Samedi</strong> : accueil dès 9 h ; pratique de 9 h 30 à 12 h 30 ; repas de 12 h 30 à 13 h 45 (prévoir un repas léger) ; échange et pratique de 13 h 45 à 17 h.</p>
                    <p><strong>Dimanche</strong> : pratique de 9 h à 12 h.</p>
                    <p><strong>À apporter</strong> : couverture, tenue chaude et confortable, support pour l’assise. Pour la soirée : votre tasse marquée à votre nom ; tisanes et eau chaude sur place, collation à partager.</p>
                  </div>
                  <div>
                    <h3>Sibylle Schatz-Botti et François Botti</h3>
                    <p>
                      Née en Allemagne, Sibylle découvre le yoga en 1996 et devient professeure (BDY/EYU) en 2001 ; elle enseigne en France depuis 2005, en cours collectifs et en soirées « mantra et méditation ». François découvre le yoga en Inde en 1985 ; diplômé de l’École Française de Yoga de Lyon en 2005 (Yoga de l’énergie), il enseigne depuis 2003.
                    </p>
                    <p>
                      Depuis 2019, tous deux suivent l’enseignement de Bernard Bouanchaud (Viniyoga Fondation France) ; ils sont certifiés en yogathérapie depuis février 2025.
                    </p>
                  </div>
                  <div>
                    <h3>Inscription</h3>
                    <p>Priorité aux adhérents de Chemins d’Éveil ; le stage reste ouvert à tous. Le week-end complet est conseillé et prioritaire.</p>
                    <p>Bulletin et règlement à Françoise Bataillard, 130 rue du presbytère, 39570 Revigny.</p>
                    <p>Aucun remboursement en cas de désistement moins d’une semaine avant le stage.</p>
                    <p>
                      Renseignements : Anne-Marie Meudre, <a href="tel:+33786820545">07 86 82 05 45</a> ; Françoise Bataillard, <a href="tel:+33626256588">06 26 25 65 88</a>.
                    </p>
                  </div>
                </div>
              </div>
            </section>
          </>
        )
      }

      <section class="plane sheet" data-station={at('professeurs')} id="professeurs" aria-labelledby="profs-title">
        <div class="s-wrap">
          <p class="chap">{num('professeurs')} — L’équipe</p>
          <h2 id="profs-title">Professeures</h2>
          <ul class="people">
            {
              teachers.map((teacher) => (
                <li class="person">
                  {teacher.portrait ? (
                    <Picture
                      src={portrait}
                      formats={['avif', 'webp']}
                      fallbackFormat="png"
                      width={90}
                      height={90}
                      alt={`Portrait de ${teacher.name}, professeure de yoga à l’association Chemins d’Éveil.`}
                    />
                  ) : (
                    <span class="mono" aria-hidden="true">
                      {teacher.initials}
                    </span>
                  )}
                  <div>
                    <h3>{teacher.name}</h3>
                    <p class="meta">{teacher.type}</p>
                    <ul class="slots">
                      {slotsOf(teacher.name).map((slot) => (
                        <li>{slot}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="bio">
                    {teacher.bio.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="plane sheet" data-station={at('lieu')} id="lieu" aria-labelledby="lieu-title">
        <div class="s-wrap lieu-grid">
          <div>
            <p class="chap">{num('lieu')} — Perrigny</p>
