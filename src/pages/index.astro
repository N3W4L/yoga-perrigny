            <p class="address">
              <span>{association.street}</span>
              <span>{association.postal}</span>
            </p>
            <p>{association.place}. La salle est équipée d’un ascenseur.</p>
            <p>
              <a href={itinerary}>Itinéraire</a>
            </p>
            {
              flags.showRessources && (
                <p>
                  <a href={pdfs.bibliotheque}>Bibliothèque de l’association <span class="sr-only">(PDF)</span></a>
                </p>
              )
            }
          </div>
          <figure class="frame-photo frame-photo-place">
            <Picture
              src={exterior}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              widths={[480, 768, 1024]}
              sizes="(min-width: 62rem) 40rem, 100vw"
              alt="Extérieur du bâtiment des cours, à Perrigny : façade en pierre claire, jardinières fleuries et rue ensoleillée."
              quality={62}
            />
            <figcaption>Le bâtiment, rue du moulin.</figcaption>
          </figure>
        </div>
      </section>

      <section class="plane sheet" data-station={at('contact')} id="contact" aria-labelledby="contact-title">
        <div class="s-wrap">
          <p class="chap">Écrire</p>
          <h2 id="contact-title">Contact</h2>
          <p>Pas de formulaire : un courriel suffit.</p>
          <p><a class="mail" href={mailto}>{association.email}</a></p>
          <p>
            {association.phonePerson} · <a href={`tel:${association.phoneTel}`}>{association.phoneDisplay}</a> · <a href={`mailto:${association.phoneEmail}`}>{association.phoneEmail}</a>
          </p>
          <p><a href="#inscriptions">Adresses pour l’envoi des fiches</a></p>
        </div>
        <footer class="s-foot">
          <div class="s-wrap">
            <div class="s-foot-row">
              <a class="s-mark" href="#accueil" aria-label="Yoga Perrigny"><Logo /></a>
              <nav aria-label="Pied de page">
                <ul>
                  <li><a href={`${import.meta.env.BASE_URL}mentions-legales/`}>Mentions légales</a></li>
                  <li><a href={`${import.meta.env.BASE_URL}confidentialite/`}>Politique de confidentialité</a></li>
                  <li><a href={mailto}>Contact</a></li>
                </ul>
              </nav>
            </div>
            <p>Tous droits réservés</p>
          </div>
        </footer>
      </section>
          </div>
          </div>
        </div>
